# Copy to .env and fill in the values. Do not commit real secrets.

# --- Database (Supabase Postgres) ---
# Pooled connection used by the app at runtime (pgbouncer, port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct session-mode connection used by the Prisma CLI for migrations/seed (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Supabase Auth ---
# Project Settings → API in the Supabase dashboard. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
